{
  "name": "whosequote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wer hat's gesagt? — Anime vs. Realität Zitate-Quiz",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-content.ts",
    "sync-assets": "tsx scripts/sync-assets.ts",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "test:e2e": "node scripts/smoke-test.mjs",
    "test": "npm run validate && tsc -b && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "zod": "^3.25.67"
  }
}
